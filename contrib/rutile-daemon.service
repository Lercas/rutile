# systemd user unit: cp to ~/.config/systemd/user/ and run
#   systemctl --user enable --now rutile-daemon
[Unit]
Description=rutile secrets broker daemon

[Service]
ExecStart=%h/go/bin/rutile daemon
Restart=on-failure
# hardening: the daemon only needs its home dir and the socket
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.rutile

[Install]
WantedBy=default.target
