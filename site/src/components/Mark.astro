---
// The brand mark: three gold needles sealed in a hex crystal.
// Needles intersect pairwise (never at one point) — see the brand book.
interface Props { id: string; size?: number; glyphOnly?: boolean; dim?: boolean }
const { id, size = 30, glyphOnly = false, dim = false } = Astro.props;
---
<svg width={size} height={size} viewBox={glyphOnly ? '20 20 160 160' : '0 0 200 200'}
     class:list={{ dim }} aria-hidden="true">
  <defs>
    <linearGradient id={`gold-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F2C75C"/><stop offset=".55" stop-color="#D9A441"/><stop offset="1" stop-color="#A85B28"/>
    </linearGradient>
  </defs>
  {!glyphOnly && (
    <>
      <polygon points="100,12 176.21,56 176.21,144 100,188 23.79,144 23.79,56"
               fill="var(--surface)" stroke="#3A332A" stroke-width="2.5"/>
      <line x1="109" y1="26" x2="166" y2="59" stroke="#262019" stroke-width="2"/>
      <path d="M 33.45 106.63 Q 106.36 100.56 172.55 69.37 Q 99.64 75.44 33.45 106.63 Z" fill={`url(#gold-${id})`}/>
      <path d="M 46.75 55.75 Q 84.22 108.78 137.25 146.25 Q 99.78 93.22 46.75 55.75 Z" fill={`url(#gold-${id})`}/>
      <path d="M 125.01 39.98 Q 100.34 93.41 94.99 152.02 Q 119.66 98.59 125.01 39.98 Z" fill={`url(#gold-${id})`}/>
    </>
  )}
  {glyphOnly && (
    <>
      <path d="M 33.45 106.63 Q 108.18 107.32 172.55 69.37 Q 97.82 68.68 33.45 106.63 Z" fill={`url(#gold-${id})`}/>
      <path d="M 46.75 55.75 Q 79.98 113.02 137.25 146.25 Q 104.02 88.98 46.75 55.75 Z" fill={`url(#gold-${id})`}/>
      <path d="M 125.01 39.98 Q 94.55 91.86 94.99 152.02 Q 125.45 100.14 125.01 39.98 Z" fill={`url(#gold-${id})`}/>
    </>
  )}
</svg>

<style>
  .dim { opacity: .35; }
</style>
