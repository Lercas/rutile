---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Terminal from '../components/Terminal.astro';

const GH = 'https://github.com/Lercas/rutile';
const VERSION = 'v1.4.0';
const INSTALL = 'go install github.com/Lercas/rutile/cmd/rutile@latest';
const features = [
  ['default-deny policy', 'per-agent globs · --for ttl · --one-time burns after first read'],
  ['human-in-the-loop', 'denied agent files a request — you run: rutile approve <id>'],
  ['sub-agent delegation', 'child = its patterns ∩ parent policy · ttl ≤ 24h · dies with parent'],
  ['context-minimizing run', 'env injection avoids direct broker disclosure · child output still matters'],
  ['tamper-evident audit', 'hash-chained log: who, what, when, why · verify offline'],
  ['key rotation', 'fresh age identity, crash-safe re-encrypt of the whole store'],
  ['token hygiene', 'every token: --type · --expires 30d · --local-only'],
  ['network hardening', 'TLS · mTLS client certs · SPIFFE IDs · per-IP rate limit'],
  ['system mode', 'daemon under a dedicated uid · kernel peer-cred checks'],
  ['git versioning', 'every change auto-committed · rutile git push to sync'],
  ['one-shot migration', 'rutile import pass / passage / .env — done in a minute'],
  ['zero ceremony', 'daemon self-spawns · unlock on demand · auto-lock after 30m'],
];
const tools = [
  ['get_secret', 'read a value; `reason` lands in the audit log'],
  ['list_secrets', 'only the paths this agent may see'],
  ['request_access', 'ask the human, never retry-loop'],
  ['delegate_access', 'mint a scoped sub-token for a helper'],
  ['store_status', 'locked? how many secrets visible?'],
];
const compat = [
  ['mcp · stdio', ['claude code', 'claude desktop', 'cursor', 'windsurf', 'zed', 'cline / roo code', 'continue']],
  ['mcp · http', ['openai agents sdk', 'langchain / langgraph', 'crewai', 'autogen', 'custom orchestrators', 'bearer or mTLS/SPIFFE']],
  ['runs on', ['macos', 'linux', 'docker', 'systemd / launchd', 'github actions', 'one static binary']],
  ['no mcp at all?', ['any process:', 'rutile run -e KEY=path -- cmd', 'broker need not return the value']],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rutile — least-privilege secrets for AI agents</title>
  <meta name="description" content="A local secrets broker for multi-agent AI systems: age encryption, default-deny policies, context-minimizing execution, sub-agent delegation, mTLS and a tamper-evident audit log. One binary, zero cloud." />
  <meta property="og:title" content="Rutile" />
  <meta property="og:description" content="Least-privilege secrets for AI agents. Local broker: age-encrypted, policy-scoped, audited, MCP-native." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Saira:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
<div class="frame">
<div class="rails">

  <header class="site">
    <div class="brand">
      <span class="brand-mark"><Mark id="brand" size={30} /><span class="glint" aria-hidden="true"></span></span>
      <span class="brand-name">rutile</span>
      <span class="brand-ver mono">{VERSION}</span>
    </div>
    <nav class="mono" aria-label="Project links">
      <a class="navlink" href={`${GH}#readme`}>docs</a>
      <a class="navlink" href={`${GH}/blob/main/AGENTS.md`}>AGENTS.md</a>
      <a class="navlink" href={GH}>GitHub ↗</a>
    </nav>
  </header>

  <section class="tick" aria-label="Introduction">
    <div class="needles" aria-hidden="true">
      <i class="n1"></i><i class="n2"></i>
    </div>
    <div class="hero">
      <div>
        <h1>Secrets for AI agents&nbsp;—<br /><span class="gold">scoped, local, auditable.</span></h1>
        <div class="hero-cta">
          <button type="button" class="btn btn-gold" id="copy-install" data-cmd={INSTALL}>go install</button>
          <a class="btn btn-ghost" href={GH}>GitHub</a>
        </div>
      </div>
      <div class="hero-side mono">
        <Mark id="hero" size={120} dim />
        <div class="hero-tag">gold needles, sealed in quartz.</div>
        <div class="muted">age-encrypted<br />policy-scoped<br />audited<br />MCP-native</div>
      </div>
    </div>
    <Terminal />
  </section>

  <section aria-label="How it works">
    <div class="kicker"><span class="star">*</span><span>what the policy engine does</span></div>
    <div class="demos">

      <article data-fade class="demo">
        <div class="demo-head mono">
          <p><span class="gold">01</span> — policy is a file</p>
          <span class="faint">policy.yaml</span>
        </div>
        <div class="mono demo-code">
          <div><span class="muted">rules:</span></div>
          <div><span class="muted">- agent:</span> claude</div>
          <div><span class="muted">&nbsp;&nbsp;pattern:</span> "dev/**"</div>
          <div><span class="muted">&nbsp;&nbsp;expires_at:</span> 18:42</div>
          <div><span class="muted">&nbsp;&nbsp;one_time:</span> <span class="gold">false</span></div>
        </div>
        <p class="demo-note mono">everything else: <span class="bad">denied by default</span> · reviewable in git</p>
      </article>

      <article data-fade class="demo">
        <div class="demo-head mono"><p><span class="gold">02</span> — avoid direct broker disclosure</p></div>
        <div class="mono zerorows">
          <div><span class="faint">agent sees</span><span>$STRIPE_KEY</span><span class="muted">— the name</span></div>
          <div><span class="faint">process gets</span><span class="gold">••••••••••••</span><span class="muted">— injected at exec</span></div>
          <div><span class="faint">caveat</span><span class="bad">child output</span><span class="muted">— can still expose env</span></div>
        </div>
        <p class="demo-note mono">$ rutile run -e STRIPE_KEY=dev/stripe/sk_test -- ./deploy.sh</p>
      </article>

      <article data-fade class="demo">
        <div class="demo-head mono"><p><span class="gold">03</span> — scope shrinks down the chain</p></div>
        <div class="mono chain">
          <div><span>orchestrator</span><span class="chain-line"></span><span class="gold">dev/** · 1h</span></div>
          <div class="lvl1"><span class="faint">└─</span><span>coder-agent</span><span class="chain-line"></span><span class="gold">dev/api/** · 20m</span></div>
          <div class="lvl2"><span class="faint">×</span><span>further delegation</span><span class="chain-line"></span><span class="bad">blocked · depth 1</span></div>
        </div>
        <p class="demo-note mono">child ⊆ parent, always · revoke the parent — every child dies with it</p>
      </article>

    </div>
  </section>

  <section class="tick" aria-label="Features">
    <div class="kicker"><span class="star">*</span><span>everything in the box — one binary, zero cloud</span></div>
    <div class="features">
      {features.map(([name, desc]) => (
        <div class="feature mono" data-fade>
          <span class="feature-name">{name}</span>
          <span class="feature-desc">{desc}</span>
        </div>
      ))}
    </div>
  </section>

  <section aria-label="MCP tools">
    <div class="kicker"><span class="star">*</span><span>the MCP surface your agent gets — full contract in AGENTS.md</span></div>
    <div class="tools" data-fade>
      {tools.map(([name, desc]) => (
        <div class="tool mono">
          <span class="gold">{name}</span>
          <span class="muted">{desc}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="tick" aria-label="Compatibility">
    <div class="kicker"><span class="star">*</span><span>works where your agents work</span></div>
    <div class="compat" data-fade>
      {compat.map(([head, items]) => (
        <div class="compat-col mono">
          <span class="compat-head">{head}</span>
          {items.map((it) => <span class="compat-item">{it}</span>)}
        </div>
      ))}
    </div>
  </section>

  <section aria-label="Trust">
    <div class="trust mono" data-fade>
      <div><span>hash-chained audit log</span><br /><span class="muted">tamper-evident, verifiable offline</span></div>
      <div><span>one static binary · zero cloud</span><br /><span class="muted">your machine — or your host: TLS, mTLS, SPIFFE</span></div>
      <div><span>honest threat model</span><br /><span class="muted">read <a class="ulink" href={`${GH}/blob/main/SECURITY.md`}>SECURITY.md</a></span></div>
    </div>
  </section>

  <footer class="site">
    <div class="foot">
      <div class="foot-left">
        <Mark id="footer" size={18} glyphOnly />
        <button type="button" class="mono install" id="copy-install-2" data-cmd={INSTALL}>{INSTALL}</button>
      </div>
      <div class="foot-links mono">
        <a class="navlink" href={GH}>GitHub</a>
        <a class="navlink" href={`${GH}/blob/main/AGENTS.md`}>AGENTS.md</a>
        <a class="navlink" href={`${GH}/blob/main/SECURITY.md`}>SECURITY.md</a>
      </div>
      <p class="mono foot-copy">© rutile contributors · MIT</p>
    </div>
  </footer>

</div>
</div>

<style>
  header.site { display: flex; align-items: center; justify-content: space-between; padding: 22px 40px; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { position: relative; width: 30px; height: 30px; overflow: hidden; display: block; }
  .glint {
    position: absolute; top: -8px; left: 0; width: 12px; height: 46px;
    background: linear-gradient(90deg, transparent, rgba(255, 244, 214, .5), transparent);
    animation: glint 8s ease-in-out infinite;
  }
  .brand-name { font-weight: 700; font-size: 20px; letter-spacing: -0.02em; }
  .brand-ver { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 8px; padding: 2px 8px; margin-left: 6px; }
  nav { display: flex; gap: 28px; font-size: 13px; }
  .navlink { color: var(--muted); }
  .navlink:hover { color: var(--gold); }

  .needles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .needles i { position: absolute; height: 1px; display: block; }
  .needles .n1 { top: 150px; left: -80px; width: 460px; transform: rotate(-27deg);
    background: linear-gradient(90deg, transparent, rgba(232,184,75,.25), rgba(180,98,45,.12), transparent); }
  .needles .n2 { top: 80px; right: -60px; width: 380px; transform: rotate(-31deg);
    background: linear-gradient(90deg, transparent, rgba(180,98,45,.18), transparent); }

  .hero { display: grid; grid-template-columns: 1fr 300px; gap: 40px; padding: 88px 40px 72px; position: relative; }
  h1 { font-weight: 700; font-size: clamp(44px, 6.5vw, 74px); line-height: 1.02; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  .hero-cta { display: flex; gap: 12px; margin-top: 44px; flex-wrap: wrap; }
  .hero-side { display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-end; gap: 14px; font-size: 12.5px; color: var(--muted); text-align: right; line-height: 2; }
  .hero-tag { color: var(--ink); opacity: .85; }

  .demos { display: grid; grid-template-columns: repeat(3, 1fr); }
  .demo { padding: 32px 32px 36px; display: flex; flex-direction: column; gap: 18px; margin: 0; }
  .demo:not(:last-child) { border-right: 1px solid var(--line); }
  .demo-head { display: flex; align-items: baseline; justify-content: space-between; font-size: 12px; color: var(--muted); }
  .demo-head p { margin: 0; }
  .demo-head .faint { font-size: 10.5px; }
  .demo-code { font-size: 12.5px; line-height: 1.95; flex: 1; border-left: 1px solid var(--line); padding-left: 16px; }
  .demo-note { font-size: 11.5px; color: var(--muted); margin: 0; }
  .zerorows { flex: 1; display: flex; flex-direction: column; font-size: 12px; }
  .zerorows > div { display: flex; align-items: center; gap: 12px; padding: 9px 0; }
  .zerorows > div:not(:last-child) { border-bottom: 1px solid var(--line); }
  .zerorows .faint { width: 74px; flex-shrink: 0; }
  .chain { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 10px; font-size: 12px; }
  .chain > div { display: flex; align-items: center; gap: 10px; }
  .chain .lvl1 { padding-left: 18px; }
  .chain .lvl2 { padding-left: 36px; }
  .chain-line { flex: 1; border-bottom: 1px dashed var(--line); }

  .features { display: grid; grid-template-columns: repeat(4, 1fr); }
  .feature { padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line); }
  .feature:nth-child(-n+4) { border-top: none; }
  .feature:not(:nth-child(4n)) { border-right: 1px solid var(--line); }
  .feature-name { font-size: 13px; color: var(--ink); }
  .feature-name::before { content: "▸ "; color: var(--gold); }
  .feature-desc { font-size: 11.5px; color: var(--muted); line-height: 1.7; }

  .tools { display: grid; grid-template-columns: repeat(5, 1fr); }
  .tool { padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; line-height: 1.6; }
  .tool:not(:last-child) { border-right: 1px solid var(--line); }
  .tool .muted { font-size: 11px; }

  .compat { display: grid; grid-template-columns: repeat(4, 1fr); }
  .compat-col { padding: 24px 28px 30px; display: flex; flex-direction: column; gap: 9px; font-size: 12.5px; }
  .compat-col:not(:last-child) { border-right: 1px solid var(--line); }
  .compat-head { color: var(--gold); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding-bottom: 6px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
  .compat-item { color: var(--muted); transition: color .2s; }
  .compat-item:hover { color: var(--ink); }

  .trust { display: grid; grid-template-columns: repeat(3, 1fr); font-size: 13px; line-height: 1.8; }
  .trust > div { padding: 28px 40px; }
  .trust > div:not(:last-child) { border-right: 1px solid var(--line); }
  .ulink { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .ulink:hover { color: var(--gold); }

  .foot { padding: 32px 40px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .foot-left { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .install { font-size: 12.5px; color: var(--muted); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; cursor: pointer; transition: color .2s, border-color .2s; background: none; }
  .install:hover { color: var(--gold); border-color: var(--gold); }
  .foot-links { display: flex; gap: 20px; font-size: 12.5px; }
  .foot-copy { font-size: 11.5px; color: var(--muted); margin: 0; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding: 56px 20px 48px; }
    .hero-side { display: none; }
    .demos, .trust { grid-template-columns: 1fr; }
    .demo:not(:last-child), .trust > div:not(:last-child) { border-right: none; border-bottom: 1px solid var(--line); }
    header.site { padding: 16px 20px; }
    nav { gap: 16px; }
    .kicker, .trust > div, .foot { padding-left: 20px; padding-right: 20px; }
    .features { grid-template-columns: 1fr 1fr; }
    .feature { border-top: 1px solid var(--line) !important; border-right: none !important; }
    .feature:nth-child(-n+2) { border-top: none !important; }
    .feature:nth-child(odd) { border-right: 1px solid var(--line) !important; }
    .tools { grid-template-columns: 1fr; }
    .tool:not(:last-child) { border-right: none; border-bottom: 1px solid var(--line); }
    .compat { grid-template-columns: 1fr 1fr; }
    .compat-col { border-right: none !important; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  // copy-to-clipboard on both install buttons
  for (const id of ['copy-install', 'copy-install-2']) {
    const el = document.getElementById(id);
    if (!el) continue;
    const original = el.textContent;
    const act = () => {
      navigator.clipboard?.writeText(el.dataset.cmd ?? '').catch(() => {});
      el.textContent = 'copied ✓';
      setTimeout(() => { el.textContent = original; }, 1600);
    };
    el.addEventListener('click', act);
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
  }
  // scroll fade-ins
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { threshold: 0.12 });
  document.querySelectorAll('[data-fade]').forEach((el) => io.observe(el));
</script>
</body>
</html>
